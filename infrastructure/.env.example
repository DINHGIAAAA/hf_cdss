# Copy to infrastructure/.env and replace the placeholder secrets before running Docker Compose.

# Backend/API access. The frontend build uses the same key by default.
HF_CDSS_API_KEYS=change-me

# JWT auth (backend).
HF_CDSS_JWT_SECRET_KEY=change-me-in-production
HF_CDSS_JWT_ALGORITHM=HS256
HF_CDSS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Required false for http://localhost (Chrome may still accept Secure on localhost).
HF_CDSS_JWT_COOKIE_SECURE=false
# Include doctor (5173), legacy admin (5174), and prod frontend (5175) when using VITE_API_BASE_URL=http://localhost:8000.
HF_CDSS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:5175","http://127.0.0.1:5175"]
HF_CDSS_REDIS_URL=redis://:change-me@redis:6379/0
REDIS_PASSWORD=change-me
# Redis is internal to the Docker network only (no host port published).
# Optional override. Copy backend/app/data/seed_users.example.json to seed_users.json locally,
# or set HF_CDSS_AUTH_SEED_USERS_JSON explicitly (escape each $ as $$ in Docker Compose).
HF_CDSS_AUTH_SEED_USERS_JSON=

# Optional cloud override only when the Docker LLM URL points to api.openai.com
OPENAI_API_KEY=
# In-network URL for backend/airflow containers. Do not set this to localhost —
# host-shell HF_CDSS_LLM_BASE_URL=http://localhost:11434/v1 is for native runs only
# and used to poison Docker via Compose interpolation if reused here.
HF_CDSS_DOCKER_LLM_BASE_URL=http://ollama:11434/v1
HF_CDSS_LLM_MODEL=qwen2.5:7b
HF_CDSS_LLM_API_TYPE=chat_completions
# Pre-flight question planner (multi-Q split + required fields): use lightweight 1.5b.
HF_CDSS_QUESTION_PLANNER_MODEL=qwen2.5:1.5b

# Local model selection.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_AGENT_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=bge-m3
# GPU: Docker Desktop → Settings → Resources enable GPU; compose passes gpus: all to ollama.
# With qwen2.5:1.5b (~1.2GB), parallel=2 is usually OK on 4GB+ VRAM; drop to 1 if OOM.
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
NVIDIA_VISIBLE_DEVICES=all

# Host ports. Change only when these ports are already used on your machine.
POSTGRES_HOST_PORT=55432
LOCALSTACK_HOST_PORT=4566
# Inside Docker Compose services this must stay localstack (not localhost).
# Host-side scripts can override with http://localhost:4566.
HF_CDSS_S3_ENDPOINT_URL=http://localstack:4566
# Keep local processed/artifacts after store (S3 is still updated). Airflow compose defaults to false.
# HF_CDSS_CLEANUP_WORKSPACE_OUTPUTS=false
# Minimum raw S3 objects before acquire --skip-download (default 50).
# HF_CDSS_MIN_RAW_S3_OBJECTS=50
AIRFLOW_WEBSERVER_PORT=8080
DOCTOR_DASHBOARD_PORT=5173
ADMIN_DASHBOARD_PORT=5174
# Optional nginx production frontend: docker compose --profile frontend-prod up -d frontend-prod
DOCTOR_DASHBOARD_PROD_PORT=5175

# Frontend: default compose service uses Vite HMR (Dockerfile.dev).
# Leave VITE_API_BASE_URL empty to use same-origin /api via Vite → backend proxy.
# Or set http://localhost:8000 for direct browser → backend (CORS).
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://backend:8000
VITE_ADMIN_BASE_URL=http://localhost:5174
VITE_DOCTOR_DASHBOARD_URL=http://localhost:5173
VITE_CHAT_LANGUAGE=vi

# Development database credentials.
POSTGRES_USER=hf_cdss
POSTGRES_PASSWORD=hf_cdss
POSTGRES_DB=hf_cdss
NEO4J_AUTH=neo4j/password
NEO4J_PASSWORD=password

# Airflow admin account for the local Docker profile.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-airflow-secret

# Ingestion pipeline tuning (Airflow / scraper on CPU + Ollama).
HF_CDSS_LLM_TIMEOUT_SECONDS=90
HF_CDSS_INGESTION_LLM_TIMEOUT_SECONDS=300
HF_CDSS_INGESTION_LLM_MAX_TOKENS=900
# Prefer 1.5b for Airflow claim/catalog extraction (7b often times out on CPU/GPU contention).
HF_CDSS_DOCKER_INGESTION_LLM_MODEL=qwen2.5:1.5b
# Constraint condition refine: use 7b (1.5b often returns empty conditions with high confidence).
HF_CDSS_CONDITION_REFINE_LLM_MODEL=qwen2.5:7b
HF_CDSS_CONDITION_REFINE_LLM_MAX_TOKENS=400
HF_CDSS_LLM_CONCURRENCY=2
# Separate in-flight slot pools per model (1.5b extract vs 7b refine).
HF_CDSS_LLM_SLOTS_PER_MODEL=true
HF_CDSS_LLM_MAX_RETRIES=2
HF_CDSS_MAX_LLM_SECTION_CHARS=2500
HF_CDSS_MAX_LLM_CLAIMS_PER_SECTION=12
HF_CDSS_CLAIM_LLM_MIN_PATTERN_MATCHES=3
# Abort create_claims when evidence alignment drops more than this fraction (default 0.20)
# HF_CDSS_CLAIM_MAX_DROP_RATE=0.20
HF_CDSS_EMBEDDING_PARALLEL_WORKERS=2
HF_CDSS_EMBEDDING_BATCH_SIZE=32
# Values below 300 are raised to 300 in scraper.semantic.config (legacy .env may still say 180).
HF_CDSS_EMBEDDING_TIMEOUT_SECONDS=600
HF_CDSS_EMBEDDING_MAX_RETRIES=2
# CPU: use 0 to avoid queue deadlock. GPU: use 5m to keep model warm between batches.
HF_CDSS_EMBEDDING_KEEP_ALIVE=5m
# Section filter: keep if embed >= 0.52; LLM review if score in [0.40, 0.52).
HF_CDSS_SECTION_SIMILARITY_THRESHOLD=0.52
HF_CDSS_SECTION_BORDERLINE_LOW_THRESHOLD=0.40
HF_CDSS_SECTION_BORDERLINE_LLM_MAX=800
HF_CDSS_AIRFLOW_PIPELINE_TIMEOUT_HOURS=72
HF_CDSS_AIRFLOW_KG_BASE_TIMEOUT_HOURS=72
HF_CDSS_AIRFLOW_CATALOG_TIMEOUT_HOURS=72
HF_CDSS_AIRFLOW_FINALIZE_TIMEOUT_HOURS=6
HF_CDSS_AIRFLOW_LOAD_TIMEOUT_HOURS=4
HF_CDSS_AIRFLOW_STORE_TIMEOUT_HOURS=4
# derive_relationships (extract.finalize): low RAM / large chunks.jsonl
# HF_CDSS_DERIVE_LOW_MEMORY=1
# HF_CDSS_DERIVE_SQLITE_THRESHOLD_MB=400
# HF_CDSS_DERIVE_PROGRESS_EVERY=10000
# Optional overrides; defaults use data/heart_failure/.cache/{embeddings,llm_claims}
# HF_CDSS_EMBEDDING_CACHE_DIR=./data/heart_failure/.embedding_cache
# HF_CDSS_INGESTION_LLM_CACHE_DIR=./data/heart_failure/.ingestion_llm_cache
